{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetVision Pro",
  "version": "1.13.0",
  "identifier": "com.netvisionpro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetVision Pro",
        "width": 1380,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "shortDescription": "专业网络测速与诊断",
    "longDescription": "NetVision Pro — 专业级 Windows 桌面网络测速与网络诊断软件,具备真实测速引擎、网络质量分析、网络诊断、节点管理、历史记录与实时监控能力。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEQjQwQTI1NkZBNEY2NjUKUldSbDlxUnZKUXEwSGZLTW5NRnR0ZFZHQVJ6bThXY05HM3pVVGxTSVhxTEk0ZGlBWmhmNHA2ZGIK",
      "endpoints": [
        "https://github.com/yuchen0x1/Internet-Speed-Test/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
