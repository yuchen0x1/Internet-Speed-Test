{
  "name": "netvision-pro",
  "private": true,
  "version": "1.15.0",
  "description": "NetVision Pro - 专业级桌面网络测速与诊断软件",
  "type": "module",
  "scripts": {
    "docs:sync": "node scripts/sync-release-notes.mjs --write",
    "docs:check": "node scripts/sync-release-notes.mjs --check",
    "ipc:check": "node scripts/check-ipc-contract.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "icons": "node build-icons.mjs",
    "build:release": "node scripts/build-release.mjs",
    "version:check": "node scripts/check-version.mjs",
    "security:check": "node scripts/audit-dependencies.mjs",
    "research": "node scripts/research-ecosystem.mjs",
    "cli:smoke": "node scripts/smoke-cli.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.7.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.0"
  }
}
