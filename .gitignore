/.autonomous-upgrade/
/.evolution/
/NVIDIA Corporation/
/.nvwork/
/.cache/
/coverage/
/test-results/
/playwright-report/

# Release workflow staging (published assets belong on GitHub Releases)
/release-artifacts/
/release-notes.txt
*.tsbuildinfo

# Credentials and local environment (keep shareable examples)
.env
.env.*
!.env.example
.npmrc
.netrc
_netrc
.git-credentials
/.git/config.local
/.git/secrets/
/.cargo/credentials
/.cargo/credentials.toml
id_rsa
id_ed25519
*.key
*.key.*
*.pem
*.p12
*.pfx
*.password
*.password.*

# Private application data and recovery copies
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
settings.json
settings.json.*
auto_test_state.json

# Only reviewed, redacted documentation screenshots belong in Git
/docs/screenshots/*
!/docs/screenshots/*-verified.png

